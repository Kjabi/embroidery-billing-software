VITE_API_BASE_URL=/api
# English voice remains browser-local. Set to `server` only after deploying an
# authenticated self-hosted Tamil STT path and verifying it; see the whisper.cpp
# variables (VOICE_WHISPERCPP_*) in the root .env.example. The production image
# excludes faster-whisper, so `server` requires whisper.cpp or another provider.
VITE_TAMIL_STT_MODE=browser
