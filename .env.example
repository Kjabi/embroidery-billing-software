# Supabase PostgreSQL becomes the primary database when this is configured.
# Find it in Supabase: Project Settings > Database > Connection string > URI.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Required for production: a long, random value used to sign admin sessions.
APP_ENV=production
APP_SECRET_KEY=
# Comma-separated origins permitted to call the FastAPI backend.
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
# Required only when creating a brand-new, empty database.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Backend-only private Supabase Storage configuration. Never expose the service key to React.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FILES_BUCKET=lalithas-files
SUPABASE_BACKUP_BUCKET=lalithas-backups

# ---------------------------------------------------------------------------
# Voice assistant
# ---------------------------------------------------------------------------
# All defaults below are free/local: the built-in deterministic command parser
# plus browser text-to-speech. No key is required for the assistant to work.
#
# Conversation state is temporary and process-local. Use one backend worker
# (or add a shared store) if you enable the voice assistant.
VOICE_LLM_PROVIDER=deterministic       # deterministic | groq | ollama
VOICE_CONVERSATION_TTL_SECONDS=1800    # idle conversation lifetime
VOICE_CONFIRMATION_TTL_SECONDS=300     # preview stays valid for 5 minutes
VOICE_MAX_HISTORY_MESSAGES=32
VOICE_MAX_TRANSCRIPT_CHARS=1200

# Browser-local speech-to-text (the default in the admin UI).
# The panel records with the Web Audio API, cuts speech with a local VAD, and
# transcribes with Whisper via Transformers.js. No audio or transcript is sent
# to this backend. Model weights are downloaded from the public Hugging Face
# repository on first use and cached by the browser. Tamil/Tanglish are partial;
# typed commands always work.
#
# Build-time Vite overrides (set in frontend/.env, not in this backend file):
#   VITE_VOICE_ENABLED=false              # hide the whole voice panel; dashboard still works
#   VITE_VOICE_MODEL_EN=onnx-community/whisper-base
#   VITE_VOICE_MODEL_TA=onnx-community/whisper-small
#   VITE_VOICE_MODEL_TANGLISH=onnx-community/whisper-small
#   VITE_VOICE_MODEL_DTYPE=q4
#
# Optional backend transcription endpoint (POST /api/voice/transcribe). It is
# kept for API/testing use only; it is not called by the browser panel. Local
# Faster-Whisper is free software, but the first run downloads a model and
# inference needs a persistent CPU/RAM-capable backend.
VOICE_STT_PROVIDER=local               # local | groq | disabled
VOICE_STT_LANGUAGE=                    # empty = auto-detect (backend path only)
VOICE_STT_PROMPT=Lalitha Apparel embroidery blouse salwar chudi pavadai measurements bust waist shoulder sleeve armhole Madurai Tamil Tanglish
VOICE_LOCAL_MODEL_SIZE=base            # tiny | base | small | medium
VOICE_LOCAL_DEVICE=cpu
VOICE_LOCAL_COMPUTE_TYPE=int8
VOICE_LOCAL_CPU_THREADS=4
VOICE_MAX_DURATION_SECONDS=60
VOICE_MAX_UPLOAD_MB=10
VOICE_RATE_WINDOW_SECONDS=600
VOICE_MAX_REQUESTS_PER_WINDOW=120
VOICE_TTS_PROVIDER=browser             # browser text-to-speech only

# Optional Groq. It is NOT enabled automatically and the app never falls back
# to it. Do not set these unless you have independently verified a zero-cost
# allowance on your own account, including speech-to-text usage.
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional local Ollama chat model (free, runs on your own hardware).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
