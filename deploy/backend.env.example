# Copy to deploy/backend.env on the server, fill in real values, then:
#   chmod 600 deploy/backend.env
# Never commit this file.

APP_ENV=production
APP_SECRET_KEY=replace-with-openssl-rand-hex-32
FRONTEND_ORIGIN=https://<project>.pages.dev

# Supabase PostgreSQL. Use the session pooler host/port (usually 5432) for the
# current synchronous SQLAlchemy + psycopg stack, not transaction mode (6543).
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Required in production: the app refuses to start without private storage config.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Private buckets (defaults shown). Verify they exist and are private.
SUPABASE_FILES_BUCKET=lalithas-files
SUPABASE_BACKUP_BUCKET=lalithas-backups

# First boot only, when the database has no admin row. Remove afterwards.
ADMIN_INITIAL_USERNAME=lalithas
ADMIN_INITIAL_PASSWORD=<initial-admin-password>

# Browser STT is what the admin UI uses; no audio reaches the backend.
# The production image intentionally excludes faster-whisper, so the optional
# POST /api/voice/transcribe endpoint returns a clean "local speech model is
# unavailable" error. Keep `local` here (a valid provider name) rather than an
# invented value. Never enable a paid provider by default.
VOICE_STT_PROVIDER=local
VOICE_LLM_PROVIDER=deterministic
